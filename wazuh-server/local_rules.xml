<!-- PFA Project - Wazuh Manager Custom Rules
     Project: PFA (AI-based Network Intrusion Detection System)
     Wazuh Manager IP: 192.168.0.168
     
     Sections:
       1. PFA AI-NIDS Rules        (rule IDs: 100100 - 100120)
       2. Future: Nmap+Gemini      (rule IDs: 100200 - 100220) [reserved]
       3. Future: VirusTotal API   (rule IDs: 100300 - 100320) [reserved]
       4. Stock local rules sample (kept from original)
-->

<group name="pfa_ai_nids,">

  <!-- ============================================================ -->
  <!-- RULE 100100: Any event from AI-NIDS log                      -->
  <!-- Matches ALL JSON events written by app.py to blocked_ips.log -->
  <!-- ============================================================ -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="event">\.+</field>
    <description>PFA AI-NIDS: Event detected from AI model</description>
    <group>pfa,ai_nids,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100101: Normal traffic classified by AI model            -->
  <!-- ============================================================ -->
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="event">Normal</field>
    <description>PFA AI-NIDS: Normal traffic classified by AI model</description>
    <group>pfa,ai_nids,normal_traffic,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100102: Attack detected by AI model (HIGH PRIORITY)     -->
  <!-- Level 10 = triggers active response + dashboard alert        -->
  <!-- ============================================================ -->
  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <field name="event">Attack</field>
    <description>PFA AI-NIDS: Attack detected and IP blocked by AI model</description>
    <group>pfa,ai_nids,attack_detected,</group>
    <mitre>
      <id>T1190</id>
      <id>T1498</id>
    </mitre>
  </rule>

  <!-- ============================================================ -->
  <!-- RULE 100103: High-frequency attacks (same source repeated)   -->
  <!-- Fires if 5+ attacks detected in 60 seconds from same source  -->
  <!-- ============================================================ -->
  <rule id="100103" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <description>PFA AI-NIDS: High-frequency attack detected - multiple blocks from same source</description>
    <group>pfa,ai_nids,attack_flood,</group>
    <mitre>
      <id>T1498</id>
      <id>T1499</id>
    </mitre>
  </rule>

</group>


