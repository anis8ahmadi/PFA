<!-- PFA custom rules for AI detections -->
<group name="local,pfa,">

  <!-- PFA AI: Attack detected by model -->
  <rule id="200000" level="10">
    <!-- Apply only to AI JSON logs on Ubuntu agent -->
    <decoded_as>json</decoded_as>
    <field name="location">/var/log/ai_nids/blocked_ips.log</field>
    <!-- Match when the model classifies as Attack -->
    <field name="event">Attack</field>
    <description>PFA AI: Attack detected by machine learning model</description>
    <group>pfa,attack,ai,</group>
    <options>no_full_log</options>
  </rule>

  <!-- PFA AI: Normal traffic (informational) -->
  <rule id="200001" level="2">
    <decoded_as>json</decoded_as>
    <field name="location">/var/log/ai_nids/blocked_ips.log</field>
    <field name="event">Normal</field>
    <description>PFA AI: Traffic classified as normal</description>
    <group>pfa,info,ai,</group>
    <options>no_full_log</options>
  </rule>

</group>
